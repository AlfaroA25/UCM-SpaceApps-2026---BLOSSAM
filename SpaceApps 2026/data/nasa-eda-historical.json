nd control mice returns to Earth live after approximately 30 days. The second group of animals remains on the ISS for approximately 60 days. In both cases, animals are euthanized humanely, and tissue samples are harvested for subsequent study and comparison with Earth-based control groups.","link":"https://osdr.nasa.gov/bio/repo/data/payloads/RR-6","telemetryApi":"https://visualization.osdr.nasa.gov/eda/api/missions/RR-6/telemetry_data/","radiationApi":"https://visualization.osdr.nasa.gov/eda/api/missions/RR-6/radiation_data/","range":{"start":"2017-12-06","end":"2018-02-06"},"measurementCount":{"telemetrySamples":17572,"radiationSamples":49},"observations":[{"date":"2017-12-06","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":500.0},{"date":"2017-12-07","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":500.0},{"date":"2017-12-08","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":500.0},{"date":"2017-12-09","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":500.0},{"date":"2017-12-10","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":500.0},{"date":"2017-12-11","temperatureC":23.0,"humidityPercent":50.0,"co2Ppm":1350.6944},{"date":"2017-12-12","temperatureC":23.3396,"humidityPercent":43.8472,"co2Ppm":3000.0},{"date":"2017-12-13","temperatureC":24.7611,"humidityPercent":37.2431,"co2Ppm":3000.0},{"date":"2017-12-14","temperatureC":23.7993,"humidityPercent":36.8021,"co2Ppm":3000.0},{"date":"2017-12-15","temperatureC":23.5314,"humidityPercent":37.4983,"co2Ppm":2654.6098,"radiationGcr":0.16516,"radiationSaa":0.12409,"radiationTotal":0.28925},{"date":"2017-12-16","temperatureC":22.616,"humidityPercent":40.8958,"co2Ppm":2159.5729,"radiationGcr":0.16828,"radiationSaa":0.1187,"radiationTotal":0.28698},{"date":"2017-12-17","temperatureC":22.2142,"humidityPercent":40.6424,"co2Ppm":2228.9931,"radiationGcr":0.16611,"radiationSaa":0.10452,"radiationTotal":0.27063},{"date":"2017-12-18","temperatureC":22.2653,"humidityPercent":40.3125,"co2Ppm":2341.5312,"radiationGcr":0.1